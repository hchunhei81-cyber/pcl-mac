<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>PCL.Launcher</RootNamespace>
    <LangVersion>latest</LangVersion>
    <OptionExplicit>On</OptionExplicit>
    <OptionStrict>Off</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <MyType>Empty</MyType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PCL.Modules\PCL.Modules.vbproj" />
    <ProjectReference Include="$(PCL2Root)MeloongCore\Shared\MeloongCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Import Include="MeloongCore" />
    <Import Include="Newtonsoft.Json" />
    <Import Include="Newtonsoft.Json.Linq" />
    <Import Include="System.Collections.Generic" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Compression.ZipFile" Version="4.3.0" />
  </ItemGroup>
</Project>
