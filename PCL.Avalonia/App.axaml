<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PCL.Avalonia.App"
             RequestedThemeVariant="Light">
             
    <Application.Resources>
        <SolidColorBrush x:Key="PCLThemeBrush" Color="#1171d1" />
        <SolidColorBrush x:Key="PCLBackgroundBrush" Color="#E5F0F8" />
        <SolidColorBrush x:Key="PCLCardBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="PCLTextBrush" Color="#333333" />
        <SolidColorBrush x:Key="PCLSubTextBrush" Color="#666666" />
        <FontFamily x:Key="PCLFont">avares://PCL.Avalonia/Assets/Fonts#PCL</FontFamily>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="{StaticResource PCLFont}" />
        </Style>
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </Application.Styles>
</Application>
