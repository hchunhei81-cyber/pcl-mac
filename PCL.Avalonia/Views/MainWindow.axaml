<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PCL.Avalonia.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="PCL.Avalonia.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="PCL Mac 第三方重构版"
        Width="800" Height="600">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="16" RowSpacing="8">
        <TextBlock Grid.Row="0" Text="PCL Mac 第三方重构版" FontSize="20" FontWeight="Bold" />

        <StackPanel Grid.Row="1" Spacing="4">
            <TextBlock Text="Minecraft 目录:" />
            <TextBox Text="{Binding McFolder}" IsReadOnly="True" />
        </StackPanel>

        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="8">
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="版本:" />
                <TextBox Text="{Binding VersionName}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="玩家名:" />
                <TextBox Text="{Binding PlayerName}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="3" BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="8">
            <ScrollViewer>
                <TextBlock Text="{Binding LogOutput}" FontFamily="Menlo,Consolas,monospace" FontSize="12" TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>

        <Button Grid.Row="4" Content="启动" Command="{Binding LaunchCommand}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                IsEnabled="{Binding !IsBusy}" />
    </Grid>
</Window>
