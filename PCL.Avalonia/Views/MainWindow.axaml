<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PCL.Avalonia.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
    x:Class="PCL.Avalonia.Views.MainWindow"
    x:DataType="vm:MainViewModel"
    Icon="/Assets/avalonia-logo.ico"
    Title="PCL Mac 第三方重构版"
    Width="900" Height="600"
    Background="#F3F7FA">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Button.NavBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="Button.NavBtn:pointerover">
            <Setter Property="Background" Value="#33FFFFFF" />
        </Style>
        <Style Selector="Button.NavBtn.active">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#1171d1" />
        </Style>

        <Style Selector="Button.TabBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#666666" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16,4" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Button.TabBtn.active">
            <Setter Property="Background" Value="#1171d1" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Button.MenuBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#333" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.MenuBtn:pointerover">
            <Setter Property="Background" Value="#E0EAF5" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="48,*">
        <!-- 顶部导航栏 -->
        <Border Grid.Row="0" Background="#1171d1" Padding="80,0,16,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0" Text="PCL Mac 第三方重构版" Foreground="White" FontSize="18"
                    FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,40,0" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="启动" Classes="NavBtn active" Command="{Binding NavigateCommand}" CommandParameter="Launch" />
                    <Button Content="下载" Classes="NavBtn" Command="{Binding NavigateCommand}" CommandParameter="Download" />
                    <Button Content="设置" Classes="NavBtn" Command="{Binding NavigateCommand}" CommandParameter="Settings" />
                    <Button Content="更多" Classes="NavBtn" Command="{Binding NavigateCommand}" CommandParameter="More" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主体区域 -->
        <Grid Grid.Row="1" ColumnDefinitions="220,*">
            <!-- 左侧菜单 -->
            <Border Grid.Column="0" Background="#F3F7FA" Padding="12,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="Minecraft" Foreground="#666" FontSize="12" FontWeight="Bold" Margin="16,0,0,8" />
                    <Button Content="自动安装" Classes="MenuBtn" Command="{Binding NavigateCommand}" CommandParameter="Install" />
                    <Button Content="手动安装" Classes="MenuBtn" Command="{Binding NavigateCommand}" CommandParameter="Manual" />

                    <TextBlock Text="资源" Foreground="#666" FontSize="12" FontWeight="Bold" Margin="16,16,0,8" />
                    <Button Content="Mod" Classes="MenuBtn" Command="{Binding NavigateCommand}" CommandParameter="Mod" />
                    <Button Content="整合包" Classes="MenuBtn" Command="{Binding NavigateCommand}" CommandParameter="Modpack" />
                </StackPanel>
            </Border>

            <!-- 右侧内容区（根据 CurrentPage 切换） -->
            <Grid Grid.Column="1" Margin="16">
                <!-- 启动页面 -->
                <Grid IsVisible="{Binding IsLaunchPage}" ColumnDefinitions="320,*">
                    <Border Grid.Column="0" Background="White" Padding="16" CornerRadius="8" BoxShadow="0 2 8 0 #10000000">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,24">
                                <Button Content="正版" Classes="TabBtn active" />
                                <Button Content="离线" Classes="TabBtn" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Spacing="20" VerticalAlignment="Center">
                                <Border Width="80" Height="80" CornerRadius="40" BorderBrush="#1171d1" BorderThickness="2" HorizontalAlignment="Center">
                                    <Path Data="M 40,35 A 15,15 0 1 1 40,65 A 15,15 0 1 1 40,35 M 20,80 C 20,65 30,55 40,55 C 50,55 60,65 60,80" Fill="#1171d1" Stretch="Uniform" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <ComboBox Grid.Column="0" PlaceholderText="添加新账号" HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="1" Content="登录" Background="White" BorderBrush="#1171d1" Foreground="#1171d1" BorderThickness="1" CornerRadius="4" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
                                    <TextBlock Text="购买正版" Foreground="#999999" FontSize="12" />
                                    <TextBlock Text="前往官网" Foreground="#999999" FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Spacing="8">
                                <Button Command="{Binding LaunchCommand}" Background="White" BorderBrush="#1171d1" BorderThickness="1" CornerRadius="4" Padding="0,8" HorizontalAlignment="Stretch" IsEnabled="{Binding IsBusy, Converter={x:Static BoolConverters.Not}}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="启动游戏" Foreground="#1171d1" FontWeight="Bold" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding VersionName}" Foreground="#666666" FontSize="11" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <Button Grid.Column="0" Content="版本选择" Background="White" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                                    <Button Grid.Column="1" Content="版本设置" Background="White" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Margin="16,0,0,0" CornerRadius="8">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Color="#E5F0F8" Offset="0.0" />
                                <GradientStop Color="#D4E6F5" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Grid>

                <!-- 下载页面 (占位) -->
                <Grid IsVisible="{Binding IsDownloadPage}">
                    <TextBlock Text="下载页面开发中..." HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Foreground="#999" />
                </Grid>

                <!-- 设置页面 (占位) -->
                <Grid IsVisible="{Binding IsSettingsPage}">
                    <TextBlock Text="设置页面开发中..." HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Foreground="#999" />
                </Grid>

                <!-- 其他页面 (占位) -->
                <Grid IsVisible="{Binding IsMorePage}">
                    <TextBlock Text="更多页面开发中..." HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Foreground="#999" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
