<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PCL.Avalonia.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
    x:Class="PCL.Avalonia.Views.MainWindow"
    x:DataType="vm:MainViewModel"
    Icon="/Assets/avalonia-logo.ico"
    Title="PCL Mac 第三方重构版"
    Width="900" Height="600"
    Background="#F3F7FA">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Button.NavBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="Button.NavBtn:pointerover">
            <Setter Property="Background" Value="#33FFFFFF" />
        </Style>
        <Style Selector="Button.NavBtn.active">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#1171d1" />
        </Style>

        <Style Selector="Button.MenuBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#333" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.MenuBtn:pointerover">
            <Setter Property="Background" Value="#E0EAF5" />
        </Style>

        <Style Selector="Button.TabBtn">
            <Setter Property="Background" Value="#F0F0F0" />
            <Setter Property="Foreground" Value="#333" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button.TabBtn.active">
            <Setter Property="Background" Value="#1171d1" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Border.Card">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="BoxShadow" Value="0 2 8 0 #10000000" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="48,*">
        <!-- 顶部导航 -->
        <Border Grid.Row="0" Background="#1171d1" Padding="80,0,16,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0" Text="PCL Mac 第三方重构版" Foreground="White" FontSize="18"
                    FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,40,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="启动" Command="{Binding NavigateCommand}" CommandParameter="Launch" Classes="NavBtn" Classes.active="{Binding IsLaunchPage}" />
                    <Button Content="下载" Command="{Binding NavigateCommand}" CommandParameter="Download" Classes="NavBtn" Classes.active="{Binding IsDownloadPage}" />
                    <Button Content="设置" Command="{Binding NavigateCommand}" CommandParameter="Settings" Classes="NavBtn" Classes.active="{Binding IsSettingsPage}" />
                    <Button Content="更多" Command="{Binding NavigateCommand}" CommandParameter="More" Classes="NavBtn" Classes.active="{Binding IsMorePage}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主体区域 -->
        <Grid Grid.Row="1" ColumnDefinitions="220,*">
            <!-- 左侧菜单 -->
            <Border Grid.Column="0" Padding="12,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="Minecraft" Foreground="#666" FontSize="12" FontWeight="Bold" Margin="16,0,0,8" />
                    <Button Content="自动安装" Classes="MenuBtn" Command="{Binding NavigateMenuCommand}" CommandParameter="Install" />
                    <Button Content="手动安装" Classes="MenuBtn" Command="{Binding NavigateMenuCommand}" CommandParameter="Manual" />
                    <TextBlock Text="资源" Foreground="#666" FontSize="12" FontWeight="Bold" Margin="16,16,0,8" />
                    <Button Content="Mod" Classes="MenuBtn" Command="{Binding NavigateMenuCommand}" CommandParameter="Mod" />
                    <Button Content="整合包" Classes="MenuBtn" Command="{Binding NavigateMenuCommand}" CommandParameter="Modpack" />
                </StackPanel>
            </Border>

            <!-- 右侧内容区 -->
            <Grid Grid.Column="1" Margin="16">
                <!-- 1. 启动页面 -->
                <Grid IsVisible="{Binding IsLaunchPage}" ColumnDefinitions="320,*">
                    <Border Grid.Column="0" Classes="Card">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <!-- 顶部 Tab -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,24">
                                <Button Content="在线" Command="{Binding SwitchLoginModeCommand}" CommandParameter="Online" Classes="TabBtn" Classes.active="{Binding IsOfflineMode, Converter={x:Static BoolConverters.Not}}" />
                                <Button Content="离线" Command="{Binding SwitchLoginModeCommand}" CommandParameter="Offline" Classes="TabBtn" Classes.active="{Binding IsOfflineMode}" />
                            </StackPanel>

                            <!-- 中间头像 -->
                            <StackPanel Grid.Row="1" Spacing="20" VerticalAlignment="Center">
                                <Border Width="80" Height="80" CornerRadius="40" BorderBrush="#1171d1" BorderThickness="2" HorizontalAlignment="Center">
                                    <Path Data="M 40,35 A 15,15 0 1 1 40,65 A 15,15 0 1 1 40,35 M 20,80 C 20,65 30,55 40,55 C 50,55 60,65 60,80" Fill="#1171d1" Stretch="Uniform" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <!-- 已登录 -->
                                <StackPanel IsVisible="{Binding IsLoggedIn}" Spacing="8" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding PlayerName}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding LoginStatus}" FontSize="12" Foreground="#666" HorizontalAlignment="Center"/>
                                    <Button Content="退出登录" Command="{Binding LogoutCommand}" Background="Transparent" Foreground="#999" BorderThickness="0" />
                                </StackPanel>

                                <!-- 未登录 -->
                                <StackPanel IsVisible="{Binding !IsLoggedIn}" Spacing="12">
                                    <!-- 离线模式 -->
                                    <StackPanel IsVisible="{Binding IsOfflineMode}" Spacing="12">
                                        <TextBox Text="{Binding PlayerName}" PlaceholderText="输入离线用户名" />
                                        <Button Content="登录" Command="{Binding LoginCommand}" Background="#1171d1" Foreground="White" Height="40" CornerRadius="4" HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                    
                                    <!-- 在线模式 -->
                                    <StackPanel IsVisible="{Binding !IsOfflineMode}" Spacing="12">
                                        <TextBlock Text="微软正版登录开发中，敬请期待..." Foreground="#999" HorizontalAlignment="Center" />
                                        <Button Content="登录" Command="{Binding LoginCommand}" Background="#CCCCCC" Foreground="White" Height="40" CornerRadius="4" HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <!-- 底部版本和启动按钮 -->
                            <StackPanel Grid.Row="2" Spacing="8">
                                <ComboBox ItemsSource="{Binding AvailableVersions}" SelectedItem="{Binding VersionName}" HorizontalAlignment="Stretch" />
                                <Button Command="{Binding LaunchCommand}" Background="White" BorderBrush="#1171d1" BorderThickness="1" CornerRadius="4" Padding="0,8" HorizontalAlignment="Stretch" IsEnabled="{Binding IsBusy, Converter={x:Static BoolConverters.Not}}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="启动游戏" Foreground="#1171d1" FontWeight="Bold" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding VersionName}" Foreground="#666666" FontSize="11" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <Button Grid.Column="0" Content="刷新版本" Command="{Binding RefreshVersionsCommand}" Background="White" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                                    <Button Grid.Column="1" Content="版本设置" Background="White" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 右侧背景图 -->
                    <Border Grid.Column="1" Margin="16,0,0,0" CornerRadius="8">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Color="#E5F0F8" Offset="0.0" />
                                <GradientStop Color="#D4E6F5" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Grid>

                <!-- 2. 设置页面 -->
                <ScrollViewer IsVisible="{Binding IsSettingsPage}">
                    <StackPanel>
                        <TextBlock Text="启动设置" Classes="Header" />
                        <Border Classes="Card">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <TextBlock Grid.Column="0" Text="最大内存分配" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <Slider Width="200" Minimum="1024" Maximum="16384" TickFrequency="512" IsSnapToTickEnabled="True" Value="{Binding MaxMemoryMb}" />
                                        <TextBlock Text="{Binding MaxMemoryMb, StringFormat={}{0} MB}" Width="80" VerticalAlignment="Center" TextAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Java 设置" Classes="Header" />
                        <Border Classes="Card">
                            <StackPanel Spacing="12">
                                <TextBlock Text="自定义 Java 路径（留空则自动检测）" FontSize="12" Foreground="#666" />
                                <TextBox Text="{Binding JavaPath}" PlaceholderText="/path/to/java" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 3. 下载/资源页面 -->
                <Grid IsVisible="{Binding IsDownloadPage}" ColumnDefinitions="*,320" ClipToBounds="True">
                    <Border Grid.Column="0" Classes="Card" Padding="20" Margin="0,0,16,0">
                        <Grid RowDefinitions="Auto,*">
                            <!-- Tab 切换 -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
                                <Button Content="版本下载" Command="{Binding SwitchDownloadTabCommand}" CommandParameter="Install" Classes="TabBtn" Classes.active="{Binding IsDownloadInstallTab}" />
                                <Button Content="Mod" Command="{Binding SwitchDownloadTabCommand}" CommandParameter="Mod" Classes="TabBtn" Classes.active="{Binding IsDownloadModTab}" />
                                <Button Content="整合包" Command="{Binding SwitchDownloadTabCommand}" CommandParameter="Modpack" Classes="TabBtn" Classes.active="{Binding IsDownloadModpackTab}" />
                            </StackPanel>

                            <!-- 版本下载列表 -->
                            <Grid Grid.Row="1" IsVisible="{Binding IsAutoInstallMode}" RowDefinitions="Auto,*">
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                    <TextBlock Grid.Column="0" Text="{Binding DownloadStatusText}" FontSize="12" Foreground="#999" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="刷新列表" Command="{Binding FetchDownloadVersionsCommand}" Background="#1171d1" Foreground="White" CornerRadius="4" Padding="12,4" />
                                </Grid>
                                <ListBox Grid.Row="1" ItemsSource="{Binding DownloadVersions}" SelectedItem="{Binding SelectedDownloadVersion}" Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                                <TextBlock Grid.Column="0" Text="{Binding Id}" FontSize="14" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Type}" FontSize="12" Foreground="#999" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>

                            <!-- 手动导入 -->
                            <Grid Grid.Row="1" IsVisible="{Binding IsManualInstallMode}" RowDefinitions="Auto,Auto,*">
                                <StackPanel Grid.Row="0" Spacing="12">
                                    <TextBlock Text="手动导入整合包" FontSize="16" FontWeight="Bold" />
                                    <TextBox Text="{Binding ImportPath}" PlaceholderText="整合包完整路径 (.zip / .mrpack)" />
                                    <TextBox Text="{Binding ImportVersionName}" PlaceholderText="导入后的版本名称" />
                                    <Button Content="开始导入" Command="{Binding ImportPackageCommand}" Background="#1171d1" Foreground="White" FontWeight="Bold" Height="40" CornerRadius="4" HorizontalAlignment="Left" Padding="24,0" />
                                    <TextBlock Text="{Binding ImportStatus}" Foreground="#666" FontSize="12" />
                                </StackPanel>
                            </Grid>

                            <!-- 资源搜索列表 -->
                            <Grid Grid.Row="1" IsVisible="{Binding IsSearchingMode}" RowDefinitions="Auto,Auto,*">
                                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,4">
                                    <ComboBox Grid.Column="0" SelectedItem="{Binding SearchProjectType}" Margin="0,0,8,0" Width="110">
                                        <x:String>mod</x:String>
                                        <x:String>modpack</x:String>
                                        <x:String>resourcepack</x:String>
                                        <x:String>shader</x:String>
                                    </ComboBox>
                                    <TextBox Grid.Column="1" Text="{Binding SearchQuery}" PlaceholderText="输入关键词搜索" Margin="0,0,8,0"/>
                                    <Button Grid.Column="2" Content="搜索" Command="{Binding SearchResourcesCommand}" Background="#1171d1" Foreground="White" CornerRadius="4" Padding="12,4" />
                                </Grid>
                                <TextBlock Grid.Row="1" Text="{Binding SearchStatus}" FontSize="11" Foreground="#999" Margin="0,0,0,8" />
                                <ScrollViewer Grid.Row="2">
                                    <ItemsControl ItemsSource="{Binding SearchResults}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="12" Margin="0,0,0,8" Background="#F9F9F9" CornerRadius="6">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <StackPanel Grid.Column="0" Spacing="4">
                                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#666" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Author}" FontSize="11" Foreground="#999"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding Downloads, StringFormat='{}{0:N0} 下载'}" FontSize="11" Foreground="#999" VerticalAlignment="Bottom"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 右侧预览 -->
                    <Border Grid.Column="1" Classes="Card" Padding="20" IsVisible="{Binding IsAutoInstallMode}">
                        <StackPanel Spacing="16">
                            <TextBlock Text="预览" FontSize="18" FontWeight="Bold" Foreground="#333" />
                            <Border Background="#F5F5F5" CornerRadius="4" Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{Binding SelectedDownloadVersion.Id, FallbackValue='未选择项目'}" FontWeight="Bold" FontSize="16" />
                                    <TextBlock Text="{Binding SelectedDownloadVersion.Type, FallbackValue=''}" Foreground="#666" FontSize="12" />
                                </StackPanel>
                            </Border>
                            <Button Content="开始安装" Command="{Binding InstallVersionCommand}" Background="#1171d1" Foreground="White" FontWeight="Bold" Height="40" CornerRadius="4" HorizontalAlignment="Stretch" IsEnabled="{Binding SelectedDownloadVersion, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 4. 更多页面占位 -->
                <Grid IsVisible="{Binding IsMorePage}">
                    <TextBlock Text="更多页面开发中..." HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Foreground="#999" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
