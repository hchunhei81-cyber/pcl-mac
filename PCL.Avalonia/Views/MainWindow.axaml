<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PCL.Avalonia.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="650"
    x:Class="PCL.Avalonia.Views.MainWindow"
    x:DataType="vm:MainViewModel"
    Icon="/Assets/AppIcon.png"
    Title="PCL Mac 第三方重构版"
    Width="1000" Height="650"
    Background="#F3F7FA">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Button.NavBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="Button.NavBtn:pointerover">
            <Setter Property="Background" Value="#33FFFFFF" />
        </Style>
        <Style Selector="Button.NavBtn.active">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#1171d1" />
        </Style>
        <Style Selector="Button.MenuBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#333" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.MenuBtn:pointerover">
            <Setter Property="Background" Value="#E0EAF5" />
        </Style>
        <Style Selector="Button.TabBtn">
            <Setter Property="Background" Value="#F0F0F0" />
            <Setter Property="Foreground" Value="#333" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button.TabBtn.active">
            <Setter Property="Background" Value="#1171d1" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Border.Card">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="BoxShadow" Value="0 2 8 0 #10000000" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="48,*">
        <!-- 顶部导航 -->
        <Border Grid.Row="0" Background="#1171d1" Padding="80,0,16,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0" Text="PCL Mac 第三方重构版" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,40,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="启动" Command="{Binding NavigateCommand}" CommandParameter="Launch" Classes="NavBtn" Classes.active="{Binding IsLaunchPage}" />
                    <Button Content="下载" Command="{Binding NavigateCommand}" CommandParameter="Download" Classes="NavBtn" Classes.active="{Binding IsDownloadPage}" />
                    <Button Content="设置" Command="{Binding NavigateCommand}" CommandParameter="Settings" Classes="NavBtn" Classes.active="{Binding IsSettingsPage}" />
                    <Button Content="更多" Command="{Binding NavigateCommand}" CommandParameter="More" Classes="NavBtn" Classes.active="{Binding IsMorePage}" />
                </StackPanel>
                <Button Grid.Column="2" Content="检查更新" Command="{Binding ShowTestUpdateCommand}" Background="White" Foreground="#1171d1" CornerRadius="20" Padding="12,6" FontSize="12" />
            </Grid>
        </Border>

        <!-- 主体 -->
        <Grid Grid.Row="1" ColumnDefinitions="200,*">
            <!-- 左侧菜单 -->
            <Border Grid.Column="0" Padding="12,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="Minecraft" Foreground="#666" FontSize="12" FontWeight="Bold" Margin="16,0,0,8" />
                    <Button Content="自动安装" Classes="MenuBtn" Command="{Binding NavigateMenuCommand}" CommandParameter="Install" />
                    <Button Content="手动安装" Classes="MenuBtn" Command="{Binding NavigateMenuCommand}" CommandParameter="Manual" />
                    <TextBlock Text="资源" Foreground="#666" FontSize="12" FontWeight="Bold" Margin="16,16,0,8" />
                    <Button Content="Mod" Classes="MenuBtn" Command="{Binding NavigateMenuCommand}" CommandParameter="Mod" />
                    <Button Content="整合包" Classes="MenuBtn" Command="{Binding NavigateMenuCommand}" CommandParameter="Modpack" />
                </StackPanel>
            </Border>

            <!-- 右侧内容 -->
            <Grid Grid.Column="1" Margin="16">
                <!-- 启动页 -->
                <Grid IsVisible="{Binding IsLaunchPage}" ColumnDefinitions="340,*">
                    <!-- 左侧卡片 -->
                    <Border Grid.Column="0" Classes="Card" Margin="0,0,16,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="在线" Classes="TabBtn" Classes.active="{Binding IsOfflineMode, Converter={x:Static BoolConverters.Not}}" />
                                    <Button Content="离线" Classes="TabBtn" Classes.active="{Binding IsOfflineMode}" />
                                </StackPanel>

                                <Border Width="80" Height="80" CornerRadius="40" BorderBrush="#1171d1" BorderThickness="2" HorizontalAlignment="Center" Margin="0,16">
                                    <Path Data="M 40,35 A 15,15 0 1 1 40,65 A 15,15 0 1 1 40,35 M 20,80 C 20,65 30,55 40,55 C 50,55 60,65 60,80" Fill="#1171d1" Stretch="Uniform" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel IsVisible="{Binding IsLoggedIn}" Spacing="8" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding PlayerName}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding LoginStatus}" FontSize="12" Foreground="#666" HorizontalAlignment="Center"/>
                                    <Button Content="退出登录" Command="{Binding LogoutCommand}" Background="Transparent" Foreground="#999" BorderThickness="0" />
                                </StackPanel>

                                <StackPanel IsVisible="{Binding !IsLoggedIn}" Spacing="12" Margin="0,0,0,8">
                                    <StackPanel IsVisible="{Binding IsOfflineMode}" Spacing="8">
                                        <TextBox Text="{Binding PlayerName}" PlaceholderText="输入离线用户名" />
                                        <Button Content="登录" Command="{Binding LoginCommand}" Background="#1171d1" Foreground="White" Height="36" CornerRadius="4" HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </StackPanel>

                                <Separator Background="#E0E0E0" />

                                <!-- 版本管理与实例创建 -->
                                <Border Background="#F5F5F5" CornerRadius="6" Padding="12">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0" Text="新建实例并启动" FontSize="11" FontWeight="Bold" Foreground="#666" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="刷新版本" Command="{Binding RefreshVersionsCommand}" Background="Transparent" Foreground="#1171d1" FontSize="11" Padding="4,0" />
                                        </Grid>
                                        
                                        <TextBox Text="{Binding NewInstanceName}" PlaceholderText="输入实例名称 (如: 生存1)" FontSize="12" Height="28"/>
                                        <ComboBox ItemsSource="{Binding AvailableVersions}" SelectedItem="{Binding SelectedBaseVersion}" PlaceholderText="选择基础版本" FontSize="12" Height="28"/>
                                        
                                        <Button Content="创建并启动游戏" Command="{Binding CreateAndLaunchCommand}" 
                                                Background="#1171d1" Foreground="White" FontWeight="Bold" Height="36" CornerRadius="4" 
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" 
                                                IsEnabled="{Binding IsBusy, Converter={x:Static BoolConverters.Not}}" />
                                    </StackPanel>
                                </Border>

                                <Separator Background="#E0E0E0" />

                                <!-- 皮肤导入 -->
                                <Border Background="#F5F5F5" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="导入皮肤" FontSize="11" FontWeight="Bold" Foreground="#666"/>
                                        <Border Width="80" Height="80" CornerRadius="4" Background="#E0E0E0" HorizontalAlignment="Center" ClipToBounds="True">
                                            <Panel>
                                                <TextBlock Text="无预览" Foreground="#999" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding SkinPreviewImage, Converter={x:Static ObjectConverters.IsNull}}" />
                                                <Image Source="{Binding SkinPreviewImage}" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None" />
                                            </Panel>
                                        </Border>
                                        <Button Content="浏览并导入皮肤" Command="{Binding PickAndImportSkinCommand}" Background="#E0EAF5" Foreground="#1171d1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" CornerRadius="4" Height="32" FontSize="12"/>
                                    </StackPanel>
                                </Border>

                                <!-- 运行日志区 -->
                                <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                                    <TextBlock Grid.Column="0" Text="运行日志" FontSize="11" FontWeight="Bold" Foreground="#666" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="复制日志" Command="{Binding CopyLogCommand}" Background="Transparent" Foreground="#1171d1" FontSize="11" Padding="4,0" />
                                </Grid>
                                <Border Background="#1E1E1E" CornerRadius="4" Height="140">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <TextBlock Text="{Binding LogOutput}" Foreground="#DDDDDD" FontFamily="Menlo,Consolas,monospace" FontSize="11" TextWrapping="Wrap" Padding="8"/>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- 右侧实例区域 -->
                    <Grid Grid.Column="1" ColumnDefinitions="220,*">
                        <Border Grid.Column="0" Classes="Card" Margin="0,0,16,0">
                            <Grid RowDefinitions="Auto,*">
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="16,16,16,8">
                                    <TextBlock Grid.Column="0" Text="实例列表" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="刷新" Command="{Binding RefreshVersionsCommand}" Background="Transparent" Foreground="#1171d1" Padding="4" FontSize="12" CornerRadius="4" />
                                </Grid>
                                <ListBox x:Name="InstanceListBox" Grid.Row="1" ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance, Mode=TwoWay}" Background="Transparent" BorderThickness="0" Margin="8,0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8" CornerRadius="4" Margin="0,0,0,4">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" />
                                                    <TextBlock Text="{Binding BaseVersion, StringFormat='基础版本: {0}'}" FontSize="12" Foreground="#666" />
                                                    <TextBlock Text="双击启动" FontSize="10" Foreground="#1171d1" Opacity="0.8" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Classes="Card">
                            <Grid RowDefinitions="Auto,Auto,Auto,*">
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="16,16,16,8">
                                    <TextBlock Grid.Column="0" Text="{Binding SelectedInstance.Name, FallbackValue='未选择实例'}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <Button Content="打开" Command="{Binding OpenSelectedFolderCommand}" Background="#E0EAF5" Foreground="#1171d1" CornerRadius="4" Padding="12,4" />
                                        <Button Content="删除" Command="{Binding DeleteInstanceCommand}" Background="#FFEBEE" Foreground="#C62828" CornerRadius="4" Padding="12,4" />
                                    </StackPanel>
                                </Grid>

                                <!-- 重命名输入框 -->
                                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="16,0,16,8" IsVisible="{Binding SelectedInstance, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <TextBox Grid.Column="0" x:Name="RenameBox" Text="{Binding SelectedInstance.Name}" Margin="0,0,8,0" Height="32" />
                                    <Button Grid.Column="1" Content="重命名" 
                                            Command="{Binding RenameInstanceCommand}" 
                                            CommandParameter="{Binding #RenameBox.Text}" 
                                            Background="#F0F0F0" Foreground="#333" CornerRadius="4" Padding="12,4" />
                                </Grid>
                                <TextBlock Grid.Row="2" Text="Mod 列表" FontSize="14" FontWeight="Bold" Margin="16,8,16,8" />
                                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding CurrentMods}" Margin="16,0,16,16">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#F9F9F9" CornerRadius="4" Padding="8" Margin="0,0,0,4">
                                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                        <StackPanel Grid.Column="0" Spacing="2">
                                                            <TextBlock Text="{Binding FileName}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="已禁用" Foreground="#FF8C00" FontSize="10" IsVisible="{Binding !IsEnabled}" />
                                                        </StackPanel>
                                                        
                                                        <Button Grid.Column="1" Content="禁用" Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).ToggleModCommand}" CommandParameter="{Binding}" 
                                                                IsVisible="{Binding IsEnabled}" Background="#E0EAF5" Foreground="#1171d1" CornerRadius="4" Padding="6,2" FontSize="10" />
                                                        
                                                        <Button Grid.Column="1" Content="启用" Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).ToggleModCommand}" CommandParameter="{Binding}" 
                                                                IsVisible="{Binding !IsEnabled}" Background="#E8F5E9" Foreground="#2E7D32" CornerRadius="4" Padding="6,2" FontSize="10" />
                                                        
                                                        <Button Grid.Column="2" Content="删除" Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).DeleteModCommand}" CommandParameter="{Binding}" 
                                                                Background="#FFEBEE" Foreground="#C62828" CornerRadius="4" Padding="6,2" FontSize="10" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- 设置页 -->
                <ScrollViewer IsVisible="{Binding IsSettingsPage}">
                    <StackPanel>
                        <TextBlock Text="启动设置" FontSize="16" FontWeight="Bold" Margin="0,16,0,8" />
                        <Border Classes="Card" Margin="0,0,0,16">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <TextBlock Grid.Column="0" Text="最大内存分配" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <Slider Width="200" Minimum="1024" Maximum="16384" TickFrequency="512" IsSnapToTickEnabled="True" Value="{Binding MaxMemoryMb}" />
                                        <TextBlock Text="{Binding MaxMemoryMb, StringFormat={}{0} MB}" Width="80" VerticalAlignment="Center" TextAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Java 设置" FontSize="16" FontWeight="Bold" Margin="0,8,0,8" />
                        <Border Classes="Card">
                            <StackPanel Spacing="12">
                                <TextBlock Text="自定义 Java 路径（留空则自动检测）" FontSize="12" Foreground="#666" />
                                <TextBox Text="{Binding JavaPath}" PlaceholderText="/path/to/java" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 下载页 -->
                <Grid IsVisible="{Binding IsDownloadPage}" ColumnDefinitions="*,280" ClipToBounds="True">
                    <Border Grid.Column="0" Classes="Card" Padding="20" Margin="0,0,16,0">
                        <Grid RowDefinitions="Auto,Auto,Auto,*">
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
                                <Button Content="版本下载" Command="{Binding SwitchDownloadTabCommand}" CommandParameter="Install" Classes="TabBtn" Classes.active="{Binding IsDownloadInstallTab}" />
                                <Button Content="Mod" IsEnabled="False" ToolTip.Tip="需要代理访问 Modrinth API" Command="{Binding SwitchDownloadTabCommand}" CommandParameter="Mod" Classes="TabBtn" Classes.active="{Binding IsDownloadModTab}" />
                                <Button Content="整合包" IsEnabled="False" ToolTip.Tip="需要代理访问 Modrinth API" Command="{Binding SwitchDownloadTabCommand}" CommandParameter="Modpack" Classes="TabBtn" Classes.active="{Binding IsDownloadModpackTab}" />
                            </StackPanel>

                            <Grid Grid.Row="1" IsVisible="{Binding IsAutoInstallMode}" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
                                <CheckBox Grid.Column="0" Content="镜像加速" IsChecked="{Binding IsUsingMirror}" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding DownloadStatusText}" FontSize="12" Foreground="#999" VerticalAlignment="Center" Margin="16,0,0,0" TextWrapping="Wrap" />
                                <Button Grid.Column="2" Content="刷新列表" Command="{Binding FetchDownloadVersionsCommand}" Background="#1171d1" Foreground="White" CornerRadius="4" Padding="12,4" VerticalAlignment="Center" />
                            </Grid>

                            <ScrollViewer Grid.Row="3" IsVisible="{Binding IsAutoInstallMode}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ListBox ItemsSource="{Binding DownloadVersions}" SelectedItem="{Binding SelectedDownloadVersion}" Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8" Background="Transparent" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Text="{Binding Id}" FontSize="14" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Type}" FontSize="12" Foreground="#999" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </ScrollViewer>

                            <Grid Grid.Row="1" Grid.RowSpan="3" IsVisible="{Binding IsManualInstallMode}" RowDefinitions="Auto,Auto,*">
                                <StackPanel Grid.Row="0" Spacing="12">
                                    <TextBlock Text="手动导入整合包" FontSize="16" FontWeight="Bold" />
                                    <TextBox Text="{Binding ImportPath}" PlaceholderText="整合包完整路径 (.zip / .mrpack)" />
                                    <TextBox Text="{Binding ImportVersionName}" PlaceholderText="导入后的版本名称" />
                                    <Button Content="开始导入" Command="{Binding ImportPackageCommand}" Background="#1171d1" Foreground="White" FontWeight="Bold" Height="40" CornerRadius="4" HorizontalAlignment="Left" Padding="24,0" />
                                    <TextBlock Text="{Binding ImportStatus}" Foreground="#666" FontSize="12" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1" Grid.RowSpan="3" IsVisible="{Binding IsSearchingMode}" RowDefinitions="Auto,Auto,*">
                                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,4">
                                    <ComboBox Grid.Column="0" SelectedItem="{Binding SearchProjectType}" Margin="0,0,8,0" Width="100">
                                        <x:String>mod</x:String>
                                        <x:String>modpack</x:String>
                                        <x:String>resourcepack</x:String>
                                        <x:String>shader</x:String>
                                    </ComboBox>
                                    <TextBox Grid.Column="1" Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="输入关键词搜索" Margin="0,0,8,0"/>
                                    <Button Grid.Column="2" Content="搜索" Command="{Binding SearchResourcesCommand}" Background="#1171d1" Foreground="White" CornerRadius="4" Padding="12,4" />
                                </Grid>
                                <TextBlock Grid.Row="1" Text="{Binding SearchStatus}" FontSize="11" Foreground="#999" Margin="0,0,0,8" />
                                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding SearchResults}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="12" Margin="0,0,0,8" Background="#F9F9F9" CornerRadius="6">
                                                    <Grid ColumnDefinitions="64,*,Auto" ColumnSpacing="12">
                                                        <!-- 1. 左侧图标 -->
                                                        <Border Grid.Column="0" Width="64" Height="64" CornerRadius="8" Background="#E0E0E0" ClipToBounds="True" VerticalAlignment="Top">
                                                            <Panel>
                                                                <!-- 占位背景 -->
                                                                <TextBlock Text="无图" Foreground="#999" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                <!-- 网络图片，如果 URL 为空或不合法则不显示 -->
                                                                <Image Source="{Binding IconUrl}" Stretch="UniformToFill" />
                                                            </Panel>
                                                        </Border>

                                                        <!-- 2. 中间文字 -->
                                                        <StackPanel Grid.Column="1" Spacing="4">
                                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="15" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#666" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Author, StringFormat='作者: {0}'}" FontSize="11" Foreground="#999"/>
                                                        </StackPanel>

                                                        <!-- 3. 右侧操作 -->
                                                        <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Downloads, StringFormat='{}{0:N0} 下载'}" FontSize="11" Foreground="#999" HorizontalAlignment="Right"/>
                                                            <Button Content="安装" 
                                                                    Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).InstallModCommand}" 
                                                                    CommandParameter="{Binding}"
                                                                    Background="#1171d1" Foreground="White" CornerRadius="4" Padding="16,6" FontSize="12" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>

                            <ProgressBar Grid.Row="4" Value="{Binding DownloadProgress}" Maximum="100" Height="8" Margin="0,16,0,0" IsVisible="{Binding IsAutoInstallMode}" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Classes="Card" Padding="20" IsVisible="{Binding IsAutoInstallMode}">
                        <StackPanel Spacing="16">
                            <TextBlock Text="预览" FontSize="18" FontWeight="Bold" Foreground="#333" />
                            <Border Background="#F5F5F5" CornerRadius="4" Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{Binding SelectedDownloadVersion.Id, FallbackValue='未选择项目'}" FontWeight="Bold" FontSize="16" />
                                    <TextBlock Text="{Binding SelectedDownloadVersion.Type, FallbackValue=''}" Foreground="#666" FontSize="12" />
                                </StackPanel>
                            </Border>
                            <Button Content="下载原版" Command="{Binding InstallVersionCommand}" Background="#1171d1" Foreground="White" FontWeight="Bold" Height="40" CornerRadius="4" HorizontalAlignment="Stretch" IsEnabled="{Binding SelectedDownloadVersion, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <Button Content="安装 Fabric" Command="{Binding InstallFabricCommand}" Background="#F0F0F0" Foreground="#333" FontWeight="Bold" Height="40" CornerRadius="4" HorizontalAlignment="Stretch" IsEnabled="{Binding SelectedDownloadVersion, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <Button Content="安装 Forge" Command="{Binding InstallForgeCommand}" Background="#F0F0F0" Foreground="#333" FontWeight="Bold" Height="40" CornerRadius="4" HorizontalAlignment="Stretch" IsEnabled="{Binding SelectedDownloadVersion, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <TextBlock Text="{Binding FabricInstallStatus}" FontSize="12" Foreground="#666" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ForgeInstallStatus}" FontSize="12" Foreground="#666" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 更多页 -->
                <Grid IsVisible="{Binding IsMorePage}">
                    <TextBlock Text="更多页面开发中..." HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Foreground="#999" />
                </Grid>
                
                <!-- 更新弹窗 -->
                <Border Grid.RowSpan="2" IsVisible="{Binding IsUpdatePopupVisible}" Background="#80000000" ZIndex="100">
                    <Border Background="White" CornerRadius="12" Padding="24" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 8 24 0 #40000000">
                        <StackPanel Spacing="16">
                            <TextBlock Text="{Binding UpdatePopupTitle}" FontSize="18" FontWeight="Bold" Foreground="#333" />
                            <TextBlock Text="{Binding UpdatePopupMessage}" FontSize="14" Foreground="#666" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" Margin="0,16,0,0">
                                <Button Content="取消" Command="{Binding CancelUpdateCommand}" Background="#F0F0F0" Foreground="#333" Padding="16,6" CornerRadius="4" />
                                <Button Content="确认更新" Command="{Binding ConfirmUpdateCommand}" Background="#1171d1" Foreground="White" Padding="16,6" CornerRadius="4" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
